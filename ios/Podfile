# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# The widget extension target is created once in Xcode (see README).
# Until it exists, skip it so `pod install` still works.
widget_target_exists = File.read(File.join(__dir__, 'LiveActivitiesDemo.xcodeproj/project.pbxproj')).include?('OrderTrackerWidget')

if widget_target_exists
  target 'OrderTrackerWidget' do
    # Same OrderActivityAttributes type as the app: one source file, no copies
    pod 'OrderActivityShared', :path => '../modules/live-activity-shared'
  end
end

target 'LiveActivitiesDemo' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Local native module: React Native <-> ActivityKit bridge
  pod 'OrderActivityShared', :path => '../modules/live-activity-shared'
  pod 'LiveActivityModule', :path => '../modules/live-activity'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
